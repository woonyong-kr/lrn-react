{
  "name": "lrn-react",
  "version": "1.0.0",
  "description": "A standalone component runtime with per-component Hooks and a runnable card collection.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "test": "node ./scripts/run-node-tests.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "virtual-dom",
    "diff",
    "patch",
    "reconciler",
    "history",
    "vanilla-js"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "private": true
}
